# Copy to .env (git-ignored) and replace every value before real use:
#   cp .env.example .env
# Generate strong values with:  openssl rand -hex 24

# Password of the PostgreSQL user "payflow".
PAYFLOW_DB_PASSWORD=dev-only-db-password-change-me

# Shared token for operator endpoints (/v1/reconciliation/**). At least 24 characters.
PAYFLOW_ADMIN_TOKEN=dev-only-admin-token-change-me-0000

# Secret the PSP uses to sign webhooks sent to /v1/webhooks/psp. At least 24 characters.
PAYFLOW_PSP_WEBHOOK_SECRET=dev-only-psp-webhook-secret-change-me

# Optional tuning (defaults shown).
# PAYFLOW_DB_POOL_SIZE=20
# PAYFLOW_FEE_BPS=250
# PAYFLOW_PORT=8080
