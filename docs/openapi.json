{
  "components" : {
    "schemas" : {
      "AuthorizeRequest" : {
        "properties" : {
          "amountMinor" : {
            "description" : "Amount in minor units (e.g. cents).",
            "example" : 10000,
            "format" : "int64",
            "type" : "integer"
          },
          "currency" : {
            "description" : "ISO-4217 currency code.",
            "example" : "USD",
            "pattern" : "^[A-Z]{3}$",
            "type" : "string"
          },
          "paymentMethodToken" : {
            "description" : "Opaque payment-method token from the client SDK.",
            "example" : "tok_visa",
            "maxLength" : 128,
            "minLength" : 0,
            "type" : "string"
          },
          "reference" : {
            "description" : "Merchant's own order reference.",
            "example" : "order-1042",
            "maxLength" : 255,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "amountMinor", "currency", "paymentMethodToken" ],
        "type" : "object"
      },
      "DiscrepancyResponse" : {
        "properties" : {
          "actualMinor" : {
            "format" : "int64",
            "type" : "integer"
          },
          "detectedAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "expectedMinor" : {
            "format" : "int64",
            "type" : "integer"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "kind" : {
            "type" : "string"
          },
          "paymentId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "subject" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "Entry" : {
        "properties" : {
          "accountId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "accountType" : {
            "type" : "string"
          },
          "amountMinor" : {
            "format" : "int64",
            "type" : "integer"
          },
          "direction" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "EventResponse" : {
        "properties" : {
          "eventId" : {
            "type" : "string"
          },
          "receivedAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "replayedAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "state" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "LedgerResponse" : {
        "properties" : {
          "paymentId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "transactions" : {
            "items" : {
              "$ref" : "#/components/schemas/Transaction"
            },
            "type" : "array"
          }
        },
        "type" : "object"
      },
      "MoneyRequest" : {
        "properties" : {
          "amountMinor" : {
            "description" : "Amount in minor units.",
            "example" : 4000,
            "format" : "int64",
            "type" : "integer"
          },
          "currency" : {
            "description" : "Must equal the payment's currency.",
            "example" : "USD",
            "pattern" : "^[A-Z]{3}$",
            "type" : "string"
          },
          "reason" : {
            "description" : "Free-text reason (refunds).",
            "example" : "customer request",
            "maxLength" : 255,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "amountMinor", "currency" ],
        "type" : "object"
      },
      "PaymentResponse" : {
        "properties" : {
          "amountMinor" : {
            "format" : "int64",
            "type" : "integer"
          },
          "authorizedMinor" : {
            "format" : "int64",
            "type" : "integer"
          },
          "capturedMinor" : {
            "format" : "int64",
            "type" : "integer"
          },
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "currency" : {
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "merchantId" : {
            "type" : "string"
          },
          "reference" : {
            "type" : "string"
          },
          "refundedMinor" : {
            "format" : "int64",
            "type" : "integer"
          },
          "state" : {
            "type" : "string"
          },
          "updatedAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "voidedMinor" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "type" : "object"
      },
      "RunDetailResponse" : {
        "properties" : {
          "discrepancies" : {
            "items" : {
              "$ref" : "#/components/schemas/DiscrepancyResponse"
            },
            "type" : "array"
          },
          "run" : {
            "$ref" : "#/components/schemas/RunResponse"
          }
        },
        "type" : "object"
      },
      "RunResponse" : {
        "properties" : {
          "discrepancyCount" : {
            "format" : "int64",
            "type" : "integer"
          },
          "failureReason" : {
            "type" : "string"
          },
          "finishedAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "paymentsChecked" : {
            "format" : "int64",
            "type" : "integer"
          },
          "startedAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "state" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "Transaction" : {
        "properties" : {
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "description" : {
            "type" : "string"
          },
          "entries" : {
            "items" : {
              "$ref" : "#/components/schemas/Entry"
            },
            "type" : "array"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "operationId" : {
            "format" : "uuid",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "VoidRequest" : {
        "properties" : {
          "reason" : {
            "description" : "Free-text reason.",
            "example" : "order cancelled",
            "maxLength" : 255,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "WebhookEndpointRequest" : {
        "properties" : {
          "signingSecret" : {
            "description" : "Secret used to sign deliveries (HMAC-SHA256). Never echoed back.",
            "maxLength" : 256,
            "minLength" : 24,
            "type" : "string"
          },
          "url" : {
            "description" : "HTTPS URL that receives signed webhook deliveries.",
            "example" : "https://merchant.example/hooks/payflow",
            "maxLength" : 2048,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "signingSecret", "url" ],
        "type" : "object"
      }
    }
  },
  "info" : {
    "description" : "Idempotent payments with a double-entry ledger. Every mutating endpoint requires an Idempotency-Key header and an X-Merchant-Id header. Errors are RFC 9457 problem+json with a stable `code`.",
    "title" : "PayFlow API",
    "version" : "1.0.0"
  },
  "openapi" : "3.0.1",
  "paths" : {
    "/v1/admin/inbound-events" : {
      "get" : {
        "operationId" : "list",
        "parameters" : [ {
          "in" : "header",
          "name" : "X-Admin-Token",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "state",
          "required" : false,
          "schema" : {
            "default" : "ABANDONED",
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "limit",
          "required" : false,
          "schema" : {
            "default" : 50,
            "format" : "int32",
            "type" : "integer"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/EventResponse"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "List inbound PSP events in a state (default ABANDONED), newest first",
        "tags" : [ "Operations" ]
      }
    },
    "/v1/admin/inbound-events/{eventId}/replay" : {
      "post" : {
        "description" : "Applies the stored event if its operation now exists. Safe to repeat: a second call answers already_processed. 409 if the operation still does not exist or the event is not ABANDONED; nothing changes then.",
        "operationId" : "replay",
        "parameters" : [ {
          "in" : "header",
          "name" : "X-Admin-Token",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "path",
          "name" : "eventId",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "additionalProperties" : {
                    "type" : "string"
                  },
                  "type" : "object"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Replay an ABANDONED inbound event",
        "tags" : [ "Operations" ]
      }
    },
    "/v1/payments" : {
      "post" : {
        "description" : "Places a hold for the given amount. Idempotent via the Idempotency-Key header.",
        "operationId" : "authorize",
        "parameters" : [ {
          "in" : "header",
          "name" : "X-Merchant-Id",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "header",
          "name" : "Idempotency-Key",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/AuthorizeRequest"
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "format" : "byte",
                  "type" : "string"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Authorize a payment",
        "tags" : [ "Payments" ]
      }
    },
    "/v1/payments/{id}" : {
      "get" : {
        "operationId" : "get",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "header",
          "name" : "X-Merchant-Id",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PaymentResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Fetch a payment",
        "tags" : [ "Payments" ]
      }
    },
    "/v1/payments/{id}/captures" : {
      "post" : {
        "operationId" : "capture",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "header",
          "name" : "X-Merchant-Id",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "header",
          "name" : "Idempotency-Key",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/MoneyRequest"
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "format" : "byte",
                  "type" : "string"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Capture an authorized amount (full or partial)",
        "tags" : [ "Payments" ]
      }
    },
    "/v1/payments/{id}/ledger" : {
      "get" : {
        "operationId" : "ledger",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "header",
          "name" : "X-Merchant-Id",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LedgerResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Fetch the double-entry ledger postings of a payment",
        "tags" : [ "Payments" ]
      }
    },
    "/v1/payments/{id}/refunds" : {
      "post" : {
        "operationId" : "refund",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "header",
          "name" : "X-Merchant-Id",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "header",
          "name" : "Idempotency-Key",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/MoneyRequest"
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "format" : "byte",
                  "type" : "string"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Refund captured money (full or partial)",
        "tags" : [ "Payments" ]
      }
    },
    "/v1/payments/{id}/voids" : {
      "post" : {
        "operationId" : "voidPayment",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "header",
          "name" : "X-Merchant-Id",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "header",
          "name" : "Idempotency-Key",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/VoidRequest"
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "format" : "byte",
                  "type" : "string"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Void the uncaptured remainder of an authorization",
        "tags" : [ "Payments" ]
      }
    },
    "/v1/reconciliation/runs" : {
      "get" : {
        "operationId" : "runs",
        "parameters" : [ {
          "in" : "header",
          "name" : "X-Admin-Token",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "limit",
          "required" : false,
          "schema" : {
            "default" : 20,
            "format" : "int32",
            "type" : "integer"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/RunResponse"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "List the most recent reconciliation runs",
        "tags" : [ "Reconciliation" ]
      }
    },
    "/v1/reconciliation/runs/{id}" : {
      "get" : {
        "operationId" : "run",
        "parameters" : [ {
          "in" : "header",
          "name" : "X-Admin-Token",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RunDetailResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "A reconciliation run with its discrepancies",
        "tags" : [ "Reconciliation" ]
      }
    },
    "/v1/reconciliation/runs/{id}/discrepancies" : {
      "get" : {
        "operationId" : "discrepancies",
        "parameters" : [ {
          "in" : "header",
          "name" : "X-Admin-Token",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/DiscrepancyResponse"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Discrepancies recorded by one reconciliation run",
        "tags" : [ "Reconciliation" ]
      }
    },
    "/v1/webhook-endpoint" : {
      "put" : {
        "operationId" : "register",
        "parameters" : [ {
          "in" : "header",
          "name" : "X-Merchant-Id",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "header",
          "name" : "Idempotency-Key",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/WebhookEndpointRequest"
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "format" : "byte",
                  "type" : "string"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Register or replace the merchant's webhook endpoint",
        "tags" : [ "Webhooks" ]
      }
    },
    "/v1/webhooks/psp" : {
      "post" : {
        "description" : "Header PSP-Signature: t=<unix seconds>,v1=<hex HMAC-SHA256 of \"<t>.\" + raw body>.",
        "operationId" : "receive",
        "parameters" : [ {
          "in" : "header",
          "name" : "PSP-Signature",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "additionalProperties" : {
                    "type" : "string"
                  },
                  "type" : "object"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Receive a PSP webhook",
        "tags" : [ "Webhooks" ]
      }
    }
  }
}
